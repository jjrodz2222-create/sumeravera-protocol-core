# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ===== SERVER CONFIG =====
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ===== SECURITY KEYS & SECRETS =====
# HMAC Secret Keys - Use strong, random values (min 32 chars)
# Generate with: openssl rand -hex 32
HMAC_SECRET_PRIMARY=generate-strong-random-secret-key-minimum-32-characters
HMAC_SECRET_SECONDARY=generate-another-random-secret-key-minimum-32-characters
HMAC_SECRET_FALLBACK=generate-fallback-random-secret-key-minimum-32-characters

# Biometric Vault Secret
BIOMETRIC_VAULT_SECRET=generate-biometric-vault-secret-key-here

# ===== EDGE NODE SECURITY =====
EDGE_NODE_WHITELIST=EDGE-NODE-01,EDGE-NODE-02,EDGE-NODE-03
EDGE_NODE_SECRET=generate-edge-node-secret-key-here

# ===== VALIDATION CONFIG =====
TIMESTAMP_SKEW_TOLERANCE=300

# ===== DATABASE CONFIG =====
DATABASE_URL=postgresql://user:password@localhost:5432/sumeravera_protocol
REDIS_URL=redis://localhost:6379

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SETTLEMENT_WINDOW_MS=3600000
RATE_LIMIT_SETTLEMENT_MAX_REQUESTS=50

# ===== LOGGING & AUDIT =====
LOG_LEVEL=info
LOG_FORMAT=json
AUDIT_LOG_RETENTION_DAYS=90
ENABLE_AUDIT_LOGGING=true
AUDIT_DATABASE_URL=postgresql://user:password@localhost:5432/sumeravera_audit

# ===== PYTHON ENGINE =====
PYTHON_PATH=python3
PYTHON_MAX_BUFFER=10485760

# ===== FEATURE FLAGS =====
ENABLE_HONEYPOT=true
ENABLE_GATE1_VALIDATION=true
ENABLE_WEBSOCKET_BROADCAST=true
ENABLE_INPUT_SANITIZATION=true

# ===== TLS/HTTPS =====
TLS_ENABLED=true
TLS_CERT_PATH=/etc/ssl/certs/server.pem
TLS_KEY_PATH=/etc/ssl/private/server-key.pem

# ===== PROTOCOL CONFIGURATION =====
PROTOCOL_VERSION=2.5.1
ENABLE_HONEYPOT_DIVERSION=true
STATE_LEDGER_ENFORCE_INVARIANTS=true
SETTLEMENT_STORE_PATH=./data/settlement_store.db
